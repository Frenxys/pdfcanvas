{
  "name": "pdfcanvas",
  "version": "0.1.4",
  "description": "Open-source PDF editor engine for the browser. Render, annotate, edit text and images, manage pages and export vector PDFs. No server required.",
  "license": "MIT",
  "author": "Enea Zani <https://github.com/Frenxys>",
  "homepage": "https://pdf.eneawork.it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frenxys/pdfcanvas.git"
  },
  "bugs": {
    "url": "https://github.com/Frenxys/pdfcanvas/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "pdf",
    "pdf-editor",
    "pdf-annotation",
    "pdfjs",
    "pdf-lib",
    "canvas",
    "browser",
    "client-side",
    "no-backend",
    "open-source"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "demo": "vite --open /demo/",
    "demo:build": "vite build --outDir demo-dist",
    "sample": "node scripts/make-sample.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
